@page "/workout"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Data
@using BlazorAppDemo.Components.Common
@inject BlazorAppDemo.Components.Data.AppDbContext DbContext
@inject BlazorAppDemo.Components.Data.UserInfo UserInfo
@inject BlazorAppDemo.Components.Services.WorkoutService WorkoutService
@inject IJSRuntime JS

<div class="workout-page">

    <div class="header-card">
        <div>
            <h1>Training Dashboard</h1>
            <p>今日のトレーニングを記録しよう</p>
        </div>

        @* 記録追加ボタン *@
        <AppButton buttonValue="＋ Add Record" OnClick="AddWorkoutRecord"/>
    </div>

    @* 本日行ったトレーニング記録がある場合 *@
    @if (workoutRecords != null && workoutRecords.Count != 0)
    {
        
        <div class="stats-grid">

            <div class="stat-card">
                <span class="stat-title">Total Workouts</span>
                <span class="stat-value"> @totalWorkouts</span>
            </div>

            <div class="stat-card">
                <span class="stat-title">This Week</span>
                <span class="stat-value"> @thisWeek</span>
            </div>

            <div class="stat-card">
                <span class="stat-title">Max Bench</span>
                <span class="stat-value"> @maxBenchWeight kg</span>
            </div>
        </div>

        <div class="content-grid">
            <div class="record-card">
                <div class="section-header">
                    <h2>Today's Records</h2>
                </div>
                <div class="record-list">
                <!-- 本日行ったトレーニングのみ表示 -->
                @foreach (var record in workoutRecords)
                {
                    <div class="record-item">
                        <div>
                            <h3>@record.MenuName</h3>
                            <p>@record.Weight kg × @record.Reps reps × @record.Sets sets</p>
                        </div>

                        <AppTrainigPart record="@record.MenuName" />
                    </div>  
                }
                </div>
            </div>

            @* 進捗 *@
            <div class="side-card">
                <div class="section-header">
                    <h2>Progress</h2>
                </div>
                <div class="progress-box">
                    <span>Weekly Goal</span>
                    <div class="progress-bar">
                        <div class="progress-fill"
                             style="width:@ProgressPercent%"></div>
                    </div>
                    <p>@thisWeek / 7 Days</p>
                </div>
            </div> 
        </div>
    }
    else
    {
        <p>No workout records found.</p>
    }

    @* AddRecordがクリックされた場合 *@
    @if (pushAddRecord)
    {
        @* 編集値 *@
        <div class="stats-grid">
            <!-- インプット用：トレーニングメニュー -->
            <div class="stat-card">
                <span class="stat-title">Training Menu</span>
                <input class="stat-value" placeholder="Bench Press" @bind="trainingMenu" />
            </div>
        </div>

        <div class="stats-grid">
            <!-- インプット用：重量 -->
            <div class="stat-card">
                <span class="stat-title">Weight</span>
                <input class="stat-value" placeholder="120" @bind="weight" />
            </div>
            <!-- インプット用：回数 -->
            <div class="stat-card">
                <span class="stat-title">Reps</span>
                <input class="stat-value" placeholder="10" @bind="reps" />
            </div>
            <!-- インプット用：セット数 -->
            <div class="stat-card">
                <span class="stat-title">Sets</span>
                <input class="stat-value" placeholder="3" @bind="sets" />
            </div>
        </div>

        @* キャンセルボタン、更新ボタン *@
        <div class="action-buttons">
            <!-- キャンセルボタン -->
            @* 記録追加ボタン *@
            <AppButton buttonValue="× Cancel" OnClick="CancelUpdate"/>
            <!-- 更新ボタン -->
            <AppButton buttonValue="＋ Update" OnClick="RegistWorkoutRecord"/>
        </div>
    }
</div>

<h3>筋トレ推移</h3>
@* ここに線グラフを表示 *@
<canvas id="workoutChart"></canvas>

@* ここに線グラフを表示 *@
<canvas id="muscleChart"></canvas>

@code{
    // トレーニング記録のリスト
    private List<WorkoutRecordInfo> workoutRecords;

    // AddRecord押下フラグ
    private bool pushAddRecord = false;
    // 入力値：Training Menu(トレーニングメニュー)
    private string trainingMenu;
    // 入力値：Weight(重量)
    private string weight;
    // 入力値：Reps(回数)
    private string reps;
    // 入力値：Sets(セット数)
    private string sets;

    // 総トレーニング回数
    private int totalWorkouts;
    // 総トレーニング回数
    private int thisWeek;
    // 総トレーニング回数
    private int maxBenchWeight;

    // 週間目標に対する進捗率
    private double ProgressPercent => (double)thisWeek / 7 * 100;

    /// <summary>
    /// 初期表示の処理
    /// 
    /// 一番古いトレーニングデータを表示する
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // DB からトレーニングデータを取得して表示する処理をここに実装
        workoutRecords = await WorkoutService.FetchTodayWorkoutRecordInfo();

        // 総トレーニング回数
        totalWorkouts = await WorkoutService.FetchTotalWorkoutCount();

        // 今週は何日トレーニングしたか？
        thisWeek = await WorkoutService.FetchThisWeeksWorkoutCount();

        // Benchの最大重量
        maxBenchWeight = await WorkoutService.FetchMaxBenchPressWeight();

    }

    /// <summary>
    /// レンダリング後の処理
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // x軸
            var labels = new[]
            {
                "月",
                "火",
                "水",
                "木",
                "金"
            };

            // プロットするデータ
            var data = new[]
            {
                80,
                82,
                85,
                87,
                90
            };

            // renderWorkoutChart関数に「label」と「data」を渡し、Chart.jsでグラフを描画する
            // renderWorkoutChart関数はwwwroot/js/chart.jsに定義されている
            await JS.InvokeVoidAsync(
                "renderWorkoutChart",
                labels,
                data);

            // 円グラフのラベル
            var pieLabels = new[]
            {
                "Chest",
                "Back",
                "Leg"
            };

            var pieData = new[]
            {
                12,
                8,
                10
            };

            // 円グラフを描画する
            await JS.InvokeVoidAsync(
                "renderMuscleChart",
                pieLabels,
                pieData);
            }
    }

    /// <summary>
    /// トレーニング記録入力フォームの表示
    /// </summary>
    /// <returns></returns>
    private void AddWorkoutRecord()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = true;
    }

    /// <summary>
    /// トレーニング記録の更新をキャンセル
    /// </summary>
    private void CancelUpdate()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = false;
    }

    /// <summary>
    /// トレーニング記録を登録処理
    /// </summary>
    /// <returns></returns>
    private async Task RegistWorkoutRecord()
    {
        // トレーニング記録追加の処理をここに実装
        WorkoutRecordInfo newRecord = new WorkoutRecordInfo
        {
            MenuName = trainingMenu,
            Weight = int.Parse(weight),
            Reps = int.Parse(reps),
            Sets = int.Parse(sets),
            TrainingDate = DateTime.Now
        };
        // DB に新しいトレーニング記録を追加する
        await WorkoutService.AddWorkoutRecord(newRecord);

        // トレーニング記録を再取得して表示を更新する
        workoutRecords = await WorkoutService.FetchTodayWorkoutRecordInfo();

        pushAddRecord = false;
    }

}