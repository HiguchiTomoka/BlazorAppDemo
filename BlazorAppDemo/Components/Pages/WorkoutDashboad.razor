@page "/workout"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Data
@using BlazorAppDemo.Components.Common
@inject BlazorAppDemo.Components.Data.AppDbContext DbContext
@inject BlazorAppDemo.Components.Data.UserInfo UserInfo
@inject BlazorAppDemo.Components.Services.WorkoutService WorkoutService
@inject IJSRuntime JS

<div class="workout-page">

    <div class="header-card">
        <div>
            <h1>Training Dashboard</h1>
            <p>今日のトレーニングを記録しよう</p>
        </div>

        @* 記録追加ボタン *@
        <AppButton buttonValue="＋ Add Record" OnClick="AddWorkoutRecord"/>
    </div>

    @* 本日行ったトレーニング記録がある場合 *@
    @if (workoutRecords != null && workoutRecords.Count != 0)
    {
        <div class="stats-grid">
            <AppTrainigRecord title="Total Workouts" value="@totalWorkouts" unit=""/>
            <AppTrainigRecord title="This Week" value="@thisWeek" unit=""/>
            <AppTrainigRecord title="Max Bench" value="@maxBenchWeight" unit="kg"/>
        </div>

        <div class="content-grid">
            <div class="record-card">
                <div class="section-header">
                    <h2>Today's Records</h2>
                </div>
                <div class="record-list">
                <!-- 本日行ったトレーニングのみ表示 -->
                @foreach (var record in workoutRecords)
                {
                    <div class="record-item">

                        <AppTrainigDetail record="@record" />

                        <AppTrainigPart menuName="@record.MenuName" />
                    </div>  
                }
                </div>
            </div>

            @* 進捗 *@
            <AppTrainingProgress thisweek="@thisWeek" ProgressPercent="@ProgressPercent" />
        </div>
    }
    else
    {
        <p>No workout records found.</p>
    }

    @* AddRecordがクリックされた場合 *@
    @if (pushAddRecord)
    {
        @* 編集値 *@
        <div class="stats-grid">
            <!-- インプット用：トレーニングメニュー -->
            @* ※@bind-Valueにすることで値が双方向にバインドされる(呼出側と呼び出される側の値が紐づく) *@
            <AppInputText inputTitle="Training Menu" placeholder="Bench Press" @bind-Value="@trainingMenu" />
        </div>

        <div class="stats-grid">
            <!-- インプット用：重量 -->
            <AppInputText inputTitle="Weight" placeholder="120" @bind-Value="@weight" />
            <!-- インプット用：回数 -->
            <AppInputText inputTitle="Reps" placeholder="10" @bind-Value="@reps" />
            <!-- インプット用：セット数 -->
            <AppInputText inputTitle="Sets" placeholder="3" @bind-Value="@sets" />
        </div>

        @* キャンセルボタン、更新ボタン *@
        <div class="action-buttons">
            <!-- キャンセルボタン -->
            @* 記録追加ボタン *@
            <AppButton buttonValue="× Cancel" OnClick="CancelUpdate"/>
            <!-- 更新ボタン -->
            <AppButton buttonValue="＋ Update" OnClick="RegistWorkoutRecord"/>
        </div>
    }
</div>

<h3>筋トレ推移</h3>
@* ここに線グラフを表示 *@
<canvas id="workoutChart"></canvas>

@* ここに線グラフを表示 *@
<canvas id="muscleChart"></canvas>

@code{
    // トレーニング記録のリスト
    private List<WorkoutRecordInfo> workoutRecords;

    // AddRecord押下フラグ
    private bool pushAddRecord = false;
    // 入力値：Training Menu(トレーニングメニュー)
    private string trainingMenu;
    // 入力値：Weight(重量)
    private string weight;
    // 入力値：Reps(回数)
    private string reps;
    // 入力値：Sets(セット数)
    private string sets;

    // 総トレーニング回数
    private int totalWorkouts;
    // 今週のトレーニング日数
    private int thisWeek;
    // 最大ベンチプレス重量
    private int maxBenchWeight;

    // 週間目標に対する進捗率
    private double ProgressPercent => (double)thisWeek / 7 * 100;

    /// <summary>
    /// 初期表示の処理
    /// 
    /// 一番古いトレーニングデータを表示する
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // DB からトレーニングデータを取得して表示する処理をここに実装
        workoutRecords = await WorkoutService.FetchTodayWorkoutRecordInfo();

        // 総トレーニング回数
        totalWorkouts = await WorkoutService.FetchTotalWorkoutCount();

        // 今週は何日トレーニングしたか？
        thisWeek = await WorkoutService.FetchThisWeeksWorkoutCount();

        // Benchの最大重量
        maxBenchWeight = await WorkoutService.FetchMaxBenchPressWeight();

    }

    /// <summary>
    /// レンダリング後の処理
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // x軸
            var labels = new[]
            {
                "月",
                "火",
                "水",
                "木",
                "金"
            };

            // プロットするデータ
            var data = new[]
            {
                80,
                82,
                85,
                87,
                90
            };

            // renderWorkoutChart関数に「label」と「data」を渡し、Chart.jsでグラフを描画する
            // renderWorkoutChart関数はwwwroot/js/chart.jsに定義されている
            await JS.InvokeVoidAsync(
                "renderWorkoutChart",
                labels,
                data);

            // 円グラフのラベル
            var pieLabels = new[]
            {
                "Chest",
                "Back",
                "Leg"
            };

            var pieData = new[]
            {
                12,
                8,
                10
            };

            // 円グラフを描画する
            await JS.InvokeVoidAsync(
                "renderMuscleChart",
                pieLabels,
                pieData);
            }
    }

    /// <summary>
    /// トレーニング記録入力フォームの表示
    /// </summary>
    /// <returns></returns>
    private void AddWorkoutRecord()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = true;
    }

    /// <summary>
    /// トレーニング記録の更新をキャンセル
    /// </summary>
    private void CancelUpdate()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = false;
    }

    /// <summary>
    /// トレーニング記録を登録処理
    /// </summary>
    /// <returns></returns>
    private async Task RegistWorkoutRecord()
    {
        // トレーニング記録追加の処理をここに実装
        WorkoutRecordInfo newRecord = new WorkoutRecordInfo
        {
            MenuName = trainingMenu,
            Weight = int.Parse(weight),
            Reps = int.Parse(reps),
            Sets = int.Parse(sets),
            TrainingDate = DateTime.Now
        };
        // DB に新しいトレーニング記録を追加する
        await WorkoutService.AddWorkoutRecord(newRecord);

        // トレーニング記録を再取得して表示を更新する
        workoutRecords = await WorkoutService.FetchTodayWorkoutRecordInfo();

        pushAddRecord = false;
    }

}