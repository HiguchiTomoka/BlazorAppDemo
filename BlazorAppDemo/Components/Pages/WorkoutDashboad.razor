@code{
    // トレーニング記録のリスト
    private List<WorkoutRecordInfo> workoutRecords;
    // AddRecord押下フラグ
    private bool pushAddRecord = false;
    // 入力値：Training Menu(トレーニングメニュー)
    private string trainingMenu;
    // 入力値：Weight(重量)
    private string weight;
    // 入力値：Reps(回数)
    private string reps;
    // 入力値：Sets(セット数)
    private string sets;

    /// <summary>
    /// 初期表示の処理
    /// 
    /// 一番古いトレーニングデータを表示する
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // DB からトレーニングデータを取得して表示する処理をここに実装
        workoutRecords = await WorkoutService.FetchWorkoutRecordInfo();
    }

    /// <summary>
    /// トレーニング記録入力フォームの表示
    /// </summary>
    /// <returns></returns>
    private void AddWorkoutRecord()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = true;
    }

    /// <summary>
    /// トレーニング記録の更新をキャンセル
    /// </summary>
    private void CancelUpdate()
    {
        // AddRecord 押下フラグの更新
        pushAddRecord = false;
    }

    /// <summary>
    /// トレーニング記録を登録処理
    /// </summary>
    /// <returns></returns>
    private async Task RegistWorkoutRecord()
    {
        // トレーニング記録追加の処理をここに実装
        WorkoutRecordInfo newRecord = new WorkoutRecordInfo
        {
            MenuName = trainingMenu,
            Weight = int.Parse(weight),
            Reps = int.Parse(reps),
            Sets = int.Parse(sets),
            TrainingDate = DateTime.Now
        };
        // DB に新しいトレーニング記録を追加する
        await WorkoutService.AddWorkoutRecord(newRecord);

        // トレーニング記録を再取得して表示を更新する
        workoutRecords = await WorkoutService.FetchWorkoutRecordInfo();
    }

}