@page "/users"
@rendermode InteractiveServer
@inject UserService UserService
@using BlazorAppDemo.Components.Service;
@using BlazorAppDemo.Components.Model;
@using BlazorAppDemo.Components;

<h3>ユーザー一覧</h3>

<!-- 検索エリア -->
<div class="search-box">
    <input @bind="searchName" placeholder="名前で検索" />
    <input type="number" @bind="minAge" placeholder="最小年齢" />

    <select @bind="isActive">
        <option value="">すべて</option>
        <option value="true">Active</option>
        <option value="false">Inactive</option>
    </select>

    <button @onclick="Search">検索</button>
</div>

<!-- ユーザー一覧 -->
@if (users != null)
{
    <ul class="user-list">
        @foreach (var user in users)
        {
            <li class="user-item" @onclick="() => OpenModal(user)">
                <div class="user-info">
                    <span class="user-name">@user.Name</span>
                    <span class="user-meta">
                        @user.Age 歳 / @user.Gender
                    </span>
                </div>

                <span class="badge @(user.IsActive ? "badge-active" : "badge-inactive")">
                    @(user.IsActive ? "Active" : "Inactive")
                </span>
            </li>
        }
    </ul>
}
else
{
    <p>検索中・・</p>
}

<!-- ページング -->
<div class="pager">
    <button @onclick="PrevPage">←</button>
    <span>Page @correntPage</span>
    <button @onclick="NextPage">→</button>
</div>

<!-- 集計 -->
<div class="summary">
    <p>Active数: @activeCount</p>
    <p>合計年齢: @totalAge</p>
</div>

@* モーダルのコンポーネント(モーダルに渡す値をここでセットしてあげる) *@
<UserDetailModal IsOpen="isModalOpen"
                 User="selectedUser"
                 OnClose="CloseModal" />

@code {
    private List<User> users = new();

    // 検索名称
    private string? searchName;
    // 検索用最小年齢
    private int? minAge;
    // アクティブかどうか
    private bool? isActive;

    private int correntPage = 1;
    private static readonly int pageSize = 9;

    private int activeCount;
    private int totalAge;

    // モーダル表示フラグ
    private bool isModalOpen = false;
    private User? selectedUser;

    protected override void OnInitialized()
    {
        LoadData();
    }

    /// <summary>
    /// データ取得処理
    /// </summary>
    private void LoadData()
    {
        users = UserService.Search(searchName, minAge, isActive, correntPage, pageSize);
        activeCount = UserService.GetActiveCount();
        totalAge = UserService.GetTotalAge();
    }

    /// <summary>
    /// 検索処理
    /// </summary>
    private void Search()
    {
        correntPage = 1;
        LoadData();
    }

    /// <summary>
    /// リストをクリックして詳細情報モーダルを表示
    /// </summary>
    private void OpenModal(User user)
    {
        selectedUser = user;
        isModalOpen = true;
    }

    /// <summary>
    /// モーダルを閉じる
    /// </summary>
    private void CloseModal()
    {
        isModalOpen = false;
    }

    /// <summary>
    /// 次へボタン押下時
    /// </summary>
    private void NextPage()
    {
        correntPage++;
        LoadData();
    }

    /// <summary>
    /// 前へボタン押下時
    /// </summary>
    private void PrevPage()
    {                 
        if (correntPage > 1)
        {
            correntPage--;
            LoadData();
        }
    }

    /// <summary>
    /// 全員表示する処理
    /// </summary>
    void ShowAll()
    {
        users = UserService.FindUsers(u => true);
    }

    /// <summary>
    /// 大人のみ表示する処理
    /// </summary>
    void ShowAdults()
    {
        users = UserService.FindUsers(u => u.Age >= 20);
    }

    /// <summary>
    /// Activeの人のみ表示する処理
    /// </summary>
    void ShowActive()
    {
        users = UserService.FindUsers(u => u.IsActive);
    }

    /// <summary>
    /// 女性のみ表示する処理
    /// </summary>
    void ShowFemale()
    {
        users = UserService.FindUsers(u => u.Gender.Equals("female"));
    }

    /// <summary>
    /// 男性のみ表示する処理
    /// </summary>
    void ShowMale()
    {
        users = UserService.FindUsers(u => u.Gender.Equals("male"));
    }
}