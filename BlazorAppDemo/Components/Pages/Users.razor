@page "/users"
@using BlazorAppDemo.Components.Data
@using Microsoft.EntityFrameworkCore
@inject BlazorAppDemo.Components.Data.AppDbContext DbContext
@inject BlazorAppDemo.Components.Data.UserInfo UserInfo

<h3>Users テーブル</h3>

@if (users == null)
{
    <p>読み込み中...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>IsDone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.IsDone</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UserInfo> users;

    protected override async Task OnInitializedAsync()
    {
        // DB に接続して Users テーブルのデータを取得
        users = await DbContext.Users.ToListAsync();

        // テストデータが空なら追加
        if (!users.Any())
        {
            DbContext.Users.Add(new UserInfo { Name = "テストユーザー", IsDone = false });
            await DbContext.SaveChangesAsync();
            users = await DbContext.Users.ToListAsync();
        }
    }
}