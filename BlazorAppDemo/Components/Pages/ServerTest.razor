@page "/serverTest"
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject BlazorAppDemo.Components.Services.UserInputState InputState

<h3>ログイン画面</h3>
<p>ログインしてください</p>

<input type="text" @oninput="OnInput" value="@InputState.InputText" placeholder="ユーザー名" />
<input type="button" @onclick="test" value="ログイン" />
<button @onclick="Save">保存</button>

@code
{
    string userName = string.Empty;
    string password = string.Empty;

    private void OnInput(ChangeEventArgs e)
    {
        // サーバーにユーザー名を保持する処理
        InputState.InputText = e.Value?.ToString() ?? "";
    }

    private void test()
    {
      // サーバーにユーザー名を保持する処理
      
      // 確認画面に飛ぶ
        navigationManager.NavigateTo("/confirm");
    }

    void Save()
    {
        InputState.SetInput(userName);
        StateHasChanged(); // 変更をレンダリングに反映
        navigationManager.NavigateTo("/another", forceLoad: false);
    }
}