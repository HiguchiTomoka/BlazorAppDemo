@page "/dietaryManagement"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Data
@using BlazorAppDemo.Components.Data.DefineDB
@using BlazorAppDemo.Components.Common
@using BlazorAppDemo.Components.Services
@using Microsoft.AspNetCore.Components.Authorization

<div class="page-container">

    <div>
        <div class="section-title">
            食事管理
        </div>

        <div class="section-subtitle">
            毎日の食事を記録・見直してみましょう
        </div>
    </div>
    
    @* 食事登録 *@
    <div class="top-content">
        <div class="content-card table-card">
            <h2>食事登録</h2>
            <AppButton buttonValue="既製品料理の登録" className="cancel-button" OnClick="registReadyMadeMeal" />
            <AppButton buttonValue="手作り料理の栄養価を登録" className="cancel-button" OnClick="registCookingMeal" />

            @* 既製商品の登録 *@
            @if (isReadyMadeMeal)
            {
                <AppRegistMealRecord mealData=@mealData OnClick=SaveMeal />
            }

            @* 自炊料理の登録 *@
            else
            {
                <div class="content-card">
                    <div class="form-group">
                        <label>料理名</label>
                        <InputText class="form-input" @bind-Value="mealData.MealName" />
                    </div>

                    <div class="form-group">
                        <label>使用重量</label>
                        <InputText class="form-input" @bind-Value="mealData.MealName" />
                    </div>

                    <AppButton buttonValue="追加" className="cancel-button" OnClick="addMenuList" />
                </div>
            }
        </div>
    </div>

    @* 食事記録 *@
    <div class="content-card table-card">
        <AppMealRecord mealList=@dashboardData.MealList title="食事一覧" totalCalories="@dashboardData.TotalCalories"
            totalProtein="@dashboardData.TotalProtein" totalCarbs="@dashboardData.TotalCarbs" totalFat="@dashboardData.TotalFat" />
    </div>

</div>

@code {
    // 登録する食事は既製品か？
    private bool isReadyMadeMeal = false;
    private List<MenulInfo> list = new List<MenulInfo>();
    private MealDashboardData dashboardData = new();

    // クッキーから取得したユーザーID
    private int userId;

    [Inject]
    private NutritionManageService NutritionManageService { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    // 登録フォーム初期化用
    private MealRecordInfo mealData = new MealRecordInfo
    {
        MealName = "塩パン",
        Calories = 320,
        Protein = 8,
        Fat = 12,
        Carbs = 45,
        MealDate = DateTime.Today
    };

    private void addMenuList()
    {
        
    }

    private void registReadyMadeMeal()
    {
        isReadyMadeMeal = true;
    }

    private void registCookingMeal()
    {
        isReadyMadeMeal = false;
    }

    /// <summary>
    /// 初期表示処理
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // ユーザーID取得
            var userIdString = user.FindFirst("UserId")?.Value;
            userId = int.Parse(userIdString);
        }

        await LoadMealRecords(userId);
    }

    /// <summary>
    /// 一覧の取得
    /// </summary>
    /// <returns></returns>
    private async Task LoadMealRecords(int userId)
    {
        // 今日の食事記録,総カロリー摂取量,総炭水化物量,総タンパク質量,総脂質量を取得
        dashboardData = await NutritionManageService.FetchDashboardData(userId);
    }

    /// <summary>
    /// 登録処理
    /// </summary>
    /// <returns></returns>
    private async Task SaveMeal()
    {
        // 登録データの成形
        MealRecordInfo registMealRecord = new MealRecordInfo
        {
            MealName = mealData.MealName,
            UserId = userId,
            Calories = mealData.Calories,
            Protein = mealData.Protein,
            Fat = mealData.Fat,
            Carbs = mealData.Carbs,
            MealDate = mealData.MealDate
        };

        // DBへ保存処理
        await NutritionManageService.AddMealRecord(registMealRecord);
    }
}