@page "/home"

@* ホーム画面 *@
<div class="top-bar">
    <div class="logo">logo</div>

    <button class="menu-button">
        ☰
    </button>
</div>

<div class="page-title">
    logo
</div>

@* ホーム *@
<div class="dashboard-grid">

    <div class="dashboard-card" @onclick='() => MovePage("/dashBord")'>
        <div class="card-icon">📈</div>
        <div class="card-title">ダッシュボード</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/mealRecords")'>
        <div class="card-icon">🍽️</div>
        <div class="card-title">食事管理</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/activityRecords")'>
        <div class="card-icon">🏋️‍♂️</div>
        <div class="card-title">運動管理</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/dashBord")'>
        <div class="card-icon">🧑‍🍳</div>
        <div class="card-title">レシピ</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/dashBord")'>
        <div class="card-icon">🚶‍♀️</div>
        <div class="card-title">歩数</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/dashBord")'>
        <div class="card-icon">👤</div>
        <div class="card-title">プロフィール</div>
    </div>

</div>

@code {
    [Inject]
    NavigationManager NavigationManager { get; set; } = default!;

    private void MovePage(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}