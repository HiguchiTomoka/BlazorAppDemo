@page "/home"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using BlazorAppDemo.Components.Services
@using BlazorAppDemo.Components.Data.DefineDB
@rendermode InteractiveServer

@* ホーム画面 *@
<div class="page-title">
    ホーム
</div>

@* ホーム *@
<div class="dashboard-grid">

    <div class="dashboard-card" @onclick='() => MovePage("/dashBord")'>
        <div class="card-icon">📈</div>
        <div class="card-title">ダッシュボード</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/dietaryManagement")'>
        <div class="card-icon">🍽️</div>
        <div class="card-title">食事管理</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/exerciseManagement")'>
        <div class="card-icon">🏋️‍♂️</div>
        <div class="card-title">運動管理</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/recipe")'>
        <div class="card-icon">🧑‍🍳</div>
        <div class="card-title">レシピ</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/numberOfSteps")'>
        <div class="card-icon">🚶‍♀️</div>
        <div class="card-title">歩数</div>
    </div>

    <div class="dashboard-card" @onclick='() => MovePage("/profile")'>
        <div class="card-icon">👤</div>
        <div class="card-title">プロフィール</div>
    </div>

</div>

@code {
    @* 認証情報 *@
    private string userName = "";
    private string email = "";
    private string password = "";

    [Inject]
    NavigationManager _NavigationManager { get; set; } = default!;

    [Inject]
    private HttpClient _HttpClient { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider _AuthenticationStateProvider { get; set; } = default!;

    [Inject]
    UserService _UserService { get; set; } = default!;

    /// <summary>
    /// 初期表示処理。クッキーからログイン情報を取得
    /// </summary>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 1回目の描画の時のみ
        if (firstRender)
        {
            // 1.認証情報の取得
            var authState =
                await _AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            var theme = "";

            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.FindFirst(ClaimTypes.Name)?.Value;
                email = user.FindFirst(ClaimTypes.Email)?.Value;
                password = user.FindFirst("Password")?.Value;
            }

            // 2.DBからUsersテーブル全データを検索
            List<UserInfo> usersRecors = await _UserService.FetchUserInfo();

            // 3.取得したデータから該当者を探す
            UserInfo userInfo = _UserService.FetchMatchUserInfo(usersRecors, email, password);

            // 4.指定されたテーマの色に変更
            await JS.InvokeVoidAsync("changeTheme", userInfo.ThemeColor);
        }
    }

    /// <summary>
    /// 引数のURLに遷移する
    /// </summary>
    /// <param name="url"></param>
    private void MovePage(string url)
    {
        _NavigationManager.NavigateTo(url);
    }

    /// <summary>
    /// ログアウト処理
    /// Cookieの削除
    /// ログイン画面に戻る
    /// </summary>
    /// <returns></returns>
    private async Task Logout()
    {
        // APIでログアウト処理を実行
        var success =
            await JS.InvokeAsync<bool>("logout");
        
        // loginページに移動
        _NavigationManager.NavigateTo("/login", true);
    }

}