@page "/profile"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Services
@using BlazorAppDemo.Components.Data.DefineDB
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<select @onchange="ChangeTheme">

    <option value="garden">庭の新鮮さ</option>

    <option value="blueberry">ブルーベリー</option>
    <option value="warmthAndSimplicity">温かみと素朴さ</option>
    <option value="freshGreen">フレッシュグリーン</option>
    <option value="spices">スパイスのような中間色</option>
    <option value="citrus">陽気な柑橘系</option>
    <option value="winterRed">冬の赤</option>
    <option value="ruby">ルビー</option>
    <option value="hazyGreen">霞んだ緑</option>
    <option value="aquaBlue">アクアブルー</option>
    <option value="arbanOasis">都会のオアシス</option>
    <option value="cosmopolitan">コスモポリタン</option>
    <option value="frienly">フレンドリー</option>
    <option value="shineOfSea">海の輝き</option>
    <option value="arcticDawn">北極の夜明け</option>
    <option value="hazyGray">霞んだグレー</option>
    <option value="glassland">草原</option>
    <option value="smartModern">スマートモダン</option>
    <option value="autumnOrange">秋のオレンジ</option>
    <option value="smokedSilver">いぶし銀</option>
    <option value="thinMiddle">薄い中間色</option>
    <option value="darkHandsome">暗いハンサム</option>
    <option value="urbanLiving">アーバンリビング</option>
    <option value="dullPurple">くすんだ紫</option>
    <option value="iceBlue">氷のような青とグレー</option>
    <option value="Pretty">可憐</option>
    <option value="coolBlue">クールブルー</option>

</select>

@code {
    @* 認証情報 *@
    private string userName;
    private string email;
    private int userId;
    private string theme;

    [Inject]
    UserService _UserService { get; set; } = default!;
    [Inject]
    IJSRuntime JS { get; set; } = default!;
    [Inject]
    private AuthenticationStateProvider _AuthenticationStateProvider { get; set; } = default!;

    /// <summary>
    /// 初期表示時、認証情報の取得
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        var authState =
            await _AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.FindFirst(ClaimTypes.Name).Value;
            email = user.FindFirst(ClaimTypes.Email)?.Value;
            userId = int.Parse(user.FindFirst("UserId")?.Value);
        }
    }

    /// <summary>
    /// テーマの変更処理
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    private async Task ChangeTheme(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString();

        // 指定されたテーマの色に変更
        await JS.InvokeVoidAsync("changeTheme", theme);

        // 更新情報の組み立て
        UserInfo updateInfo = new UserInfo 
        { 
            UserName = userName, 
            Id = userId, 
            MailAddress = email, 
            ThemeColor = theme 
        };

        // ユーザー情報に変更したテーマを登録
        await _UserService.UpdateUserInfo(updateInfo);
    }
}