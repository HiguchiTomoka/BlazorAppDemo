@page "/userscrud"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Data
@using Microsoft.EntityFrameworkCore
@inject BlazorAppDemo.Components.Data.AppDbContext DbContext
@inject BlazorAppDemo.Components.Data.UserInfo UserInfo


<h3>Users CRUD デモ</h3>

<!-- 新規ユーザー追加フォーム -->
<div>
    <input @bind="newUserName" placeholder="名前を入力" />
    <button class="btn btn-primary" @onclick="AddUser">追加</button>
</div>

<!-- ユーザー一覧 -->
@if (users == null)
{
    <p>読み込み中・・</p>
} 
else
{
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>IsDone</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>
                        <input @bind="user.Name" />
                    </td>
                    <td>
                        <input type="checkbox" @bind="user.IsDone" />
                    </td>
                    <td>
                        <button class="btn btn-success btn-sm" @onclick="() => UpdateUser(user)">更新</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(user)">削除</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}

@code {
    private List<UserInfo> users;
    private string newUserName;

    /// 概要:
    ///    初期表示処理
    ///    
    /// 戻り値:
    ///    Task(DB取得情報)
    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    /// <summary>
    /// ユーザー情報の取得処理
    /// </summary>
    /// <returns></returns>
    private async Task LoadUsers()
    {
        users = await DbContext.Users.ToListAsync<UserInfo>();
    }

    /// <summary>
    /// ユーザー登録処理
    /// </summary>
    /// <returns></returns>
    private async Task AddUser()
    {
        if (!string.IsNullOrWhiteSpace(newUserName))
        {
            var user = new UserInfo { Name = newUserName, IsDone = false };
            DbContext.Users.Add(user);
            // 登録処理
            await DbContext.SaveChangesAsync();
            // 再表示のため
            newUserName = "";
            await LoadUsers();
        }
    }

    /// <summary>
    /// ユーザー情報更新処理
    /// </summary>
    /// <param name="user"></param>
    /// <returns></returns>
    private async Task UpdateUser(UserInfo user)
    {
        DbContext.Users.Update(user);
        await DbContext.SaveChangesAsync();
        await LoadUsers();
    }

    /// <summary>
    /// ユーザー情報削除処理
    /// </summary>
    /// <param name="user"></param>
    /// <returns></returns>
    private async Task DeleteUser(UserInfo user)
    {
        DbContext.Users.Remove(user);
        await DbContext.SaveChangesAsync();
        await LoadUsers();
    }
}