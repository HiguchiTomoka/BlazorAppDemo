@page "/exerciseManagement"
@rendermode InteractiveServer
@using BlazorAppDemo.Components.Common
@using BlazorAppDemo.Components.Services
@using BlazorAppDemo.Components.Data.DefineDB
@using BlazorAppDemo.Components.Validators
@using Microsoft.AspNetCore.Components.Authorization

<div class="meal-page">

    <div class="page-header">
        <h1>運動記録</h1>
        <p>毎日の運動の記録・見直してみましょう</p>
    </div>

    @* 運動登録 *@
    <div class="top-content">
        <div class="card">
            <h2>運動登録</h2>

            @* 読み込む際はリストが空なので、 *@
            @if (ActiveNameInfo.Any())
            {
                <!-- 活動名 -->
                <select class="custom-select" @bind="activeName" @bind:after="SetActiveDetail">
                    @foreach (var activeName in ActiveNameInfo)
                    {
                        <option value="@activeName">@activeName</option>
                    }
                </select>

                <!-- 活動詳細 -->
                <select class="custom-select" @bind="activeDatail">
                    @foreach (var activeDetail in ActiveDatailInfo)
                    {
                        <option value="@activeDetail">@activeDetail</option>
                    }
                </select>
            }

            <div class="form-area">
                <div class="form-row">
                    <label>活動を行った時間 <span>必須</span></label>
                    <input type="text" class="form-input" @bind="activeTime" placeholder="30分なら0.5" />
                    <label>時間</label>
                </div>
            </div>
            <div>
                <AppButton buttonValue="登録" className="confirm-btn" OnClick="RegistActiveRecord" />
            </div>

        </div>
    </div>

    @* 運動記録 *@
    <div class="content-card table-card">
        <div class="card">
            <h2>運動記録</h2>
            <!-- TODO 運動記録の表 -->
            <div class="content-card">
                <div class="meal-list-card">
                    <table class="meal-table">
                        <thead>
                            <tr>
                                <th>活動名</th>
                                <th>活動詳細</th>
                                <th>活動時間</th>
                                <th>消費カロリー</th>
                            </tr>
                        </thead>

                        @* モーダル *@
                        @* @if (isModalOpen)
                        {
                            <div class="modal-overlay">

                                <div class="delete-modal">

                                    <h3>削除確認</h3>

                                    <p>
                                        「@selectedMeal?.DishName」 を削除しますか？
                                    </p>

                                    <div class="modal-buttons">
                                        <AppButton className="cancel-button" OnClick="CloseModal" buttonValue="キャンセル" />
                                        <AppButton className="delete-button" OnClick=DeleteFoodFromMenuList buttonValue="削除する" />
                                    </div>
                                </div>

                            </div>
                        } *@

                        <tbody>
                            @foreach (var active in activeRecordList)
                            {
                                <tr>
                                    <td>@active.ActiveKind</td>
                                    <td>@active.ActiveDetail</td>
                                    <td>@active.Time</td>
                                    <td>@active.CaloriesBurned</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TODO 消費したカロリー -->
    <div class="content-card table-card">
        <div class="card">
            <h2>消費カロリー</h2>
            @* 消費カロリー = 体重(kg) * METS * 運動時間(h) * 1.05 *@
        </div>
    </div>

</div>

@* モーダル *@
<AppMessageModal isModalOpen="isModalOpen" message="@message" />

@code {
    @* 入力値 *@
    private string activeName = string.Empty; // 種目名
    private string activeDatail = string.Empty; // 活動の詳細
    private decimal activeTime; // スポーツ等を行った時間

    @* フラグ *@
    private bool isModalOpen;// モーダル開くフラグ

    @* 認証情報 *@
    private int userId; // クッキーから取得したユーザーID

    @* モーダル参照用 *@
    private string message = string.Empty; // モーダルに送るメッセージ

    @* 初期化 *@
    private List<ActiveRecordInfo> activeRecordList = new List<ActiveRecordInfo>();
    private List<MetsInfo> metsList = new List<MetsInfo>();
    private List<MetsInfo> metsDistinctByActiveNameList = new List<MetsInfo>();
    private List<MetsInfo> metsByActiveNameList = new List<MetsInfo>();
    private List<string> ActiveNameInfo = new List<string>();
    private List<string> ActiveDatailInfo = new List<string>();
    private decimal bodyWeight;

    [Inject]
    private UserService _userService { get; set; } = default!;
    [Inject]
    private ActiveRecordService _activeRecordService { get; set; } = default!;
    [Inject]
    private AuthenticationStateProvider _authenticationStateProvider { get; set; } = default!;
    [Inject]
    private MetsInfoService _metsInfoService { get; set; } = default!;

    /// <summary>
    /// 初期表示処理
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        var authState =
            await _authenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // ユーザーID取得
            var userIdString = user.FindFirst("UserId")?.Value;
            userId = int.Parse(userIdString);
        }

        // 該当者の体重を取得
        double _BodyWeight = await _userService.FetchBodyWeight(userId);
        bodyWeight = Convert.ToDecimal(_BodyWeight);

        // 該当者の運動記録を取得
        await LoadActiveRecords(userId);

        // METS情報を取得
        await FetchMetsTable();
    }

    private async Task LoadActiveRecords(int userId)
    {
        // 過去の運動記録を入手
        activeRecordList = await _activeRecordService.FetchActiveRecordInfo(userId);
    }

    /// <summary>
    /// METSについての情報を取得
    /// </summary>
    /// <returns></returns>
    private async Task FetchMetsTable()
    {
        // METS情報を取得
        metsList = await _metsInfoService.FetchMetsInfo();

        // 活動記録名称をDistinctする
        metsDistinctByActiveNameList = await _metsInfoService.FetchActiveNameInfo();

        // 活動記録名称リストの作成
        foreach (MetsInfo metsInfo in metsDistinctByActiveNameList)
        {
            ActiveNameInfo.Add(metsInfo.ActiveNameJa);
        }

        // 活動詳細リストの設定
        SetActiveDetail();
    }

    /// <summary>
    /// 
    /// </summary>
    private async Task SetActiveDetail()
    {
        // ActiveNameのデフォルト値
        if (activeName == null) activeName = metsList[0].ActiveNameJa;

        // 表示したい活動詳細リストに対応するリストの取得
        metsDistinctByActiveNameList = await _metsInfoService.FetchActiveDetailInfo(activeName);

        // 活動詳細リストの初期化
        ActiveDatailInfo.Clear();

        // 活動詳細リストの作成
        foreach (MetsInfo metsInfo in metsDistinctByActiveNameList)
        {
            ActiveDatailInfo.Add(metsInfo.DescriptionJa);
        }

        // 活動詳細リストの先頭を選択していることにする
        activeDatail = ActiveDatailInfo[0];
    }

    /// <summary>
    /// 運動記録の登録処理
    /// </summary>
    /// <returns></returns>
    private async Task RegistActiveRecord()
    {
        // 活動種類のDictionary設定
        var activeMap = new Dictionary<string, int>();

        for (int i = 0; i < ActiveNameInfo.Count; i++)
        {
            activeMap.Add(ActiveNameInfo[i], i + 1);
        }

        // 活動種類の特定
        int activeKind = activeMap.GetValueOrDefault(activeName, 0);

        // チェック処理
        bool isError = ValidateInputData();

        if (isError)
        {
            return;
        }

        decimal metsu = _metsInfoService.FetchMets(metsList, activeName, activeDatail);
        // 消費カロリー = 体重(kg) * METS * 運動時間(h) * 1.05
        decimal caloriesBurned 
            = Decimal.Multiply(Decimal.Multiply(Decimal.Multiply(bodyWeight, metsu), Convert.ToDecimal(activeTime)), Convert.ToDecimal(1.05));

        // 登録データの組み立て
        ActiveRecordInfo inputData = new ActiveRecordInfo
        {
            UserId = userId,
            ActiveKind = activeKind,
            ActiveName = activeName,
            ActiveDetail = activeDatail,
            Time = activeTime,
            CaloriesBurned = caloriesBurned
        };

        // 登録処理
        await _activeRecordService.RegistActiveRecordInfo(inputData);

        // 登録完了後値の初期化
        activeName = metsList[0].ActiveNameJa; // 活動名
        await SetActiveDetail(); // 活動詳細セレクトボックスの初期化
        activeTime = 0; // 活動を行った時間

        // 該当者の運動記録を再取得
        await LoadActiveRecords(userId);
    }

    /// <summary>
    /// チェック処理を行う
    /// </summary>
    /// <returns></returns>
    private bool ValidateInputData()
    {
        // 時間チェック
        if (Validator.IsNullOrBlankValidate(activeTime.ToString()))
        {
            isModalOpen = true;
            message = "活動時間を入力してください";
            return true;
        }
        if (!Validator.IsOnlyNumeric(activeTime.ToString()))
        {
            isModalOpen = true;
            message = "数字を入力してください";
            return true;
        }
        // 活動名称チェック
        if (Validator.IsNullOrBlankValidate(activeName.ToString()))
        {
            isModalOpen = true;
            message = "活動時間を入力してください";
            return true;
        }
        return false;
    }

}