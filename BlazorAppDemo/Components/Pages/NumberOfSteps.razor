@page "/numberOfSteps"
@rendermode InteractiveServer
@inject BlazorAppDemo.Components.Services.ChartService ChartService
@inject IJSRuntime JS

<div class="meal-page">
    <div class="page-header">
        <h1>歩数</h1>
        <p>歩いてみましょう</p>
    </div>

    @* 1段目 *@
    <div class="chart-grid">
        <!-- PFC比 -->
        <div class="card">
            <h2>PFC Balance</h2>
            <div class="chart-container">
                <canvas id="pfcRatio"></canvas>
            </div>
        </div>

        <!-- 目標との差 -->
        <div class="card">
            <h2>目標PFCとの差</h2>
            <div class="chart-container">
                <canvas id="goalChart"></canvas>
            </div>
        </div>
    </div>

    @* 2段目 *@
    <!-- カロリー摂取推移 -->
    <div class="chart-grid">
        <div class="card">
            <h2>摂取推移</h2>
            <div class="chart-container">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
</div>
