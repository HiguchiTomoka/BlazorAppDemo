@rendermode InteractiveServer

@* ボタンコンポーネント *@
<button class="@className" @onclick="Click">
    @buttonValue
</button>

@code {
    // パラメータの再定義
    // ボタンの表示内容
    [Parameter] 
    public string? buttonValue { get; set; }
    // 割り当てるクラス名称
    [Parameter]
    public string? className { get; set; }
    // パラメータから渡ってきた処理をonClickとして定義
    [Parameter] 
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// ボタン押下時処理
    /// </summary>
    /// <returns></returns>
    private async Task Click()
    {
        await OnClick.InvokeAsync();
    }
}