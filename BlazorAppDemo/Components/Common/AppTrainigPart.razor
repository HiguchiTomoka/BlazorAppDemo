@rendermode InteractiveServer

@* 胸トレ *@
@if (chestTrainingGroups.Contains(@MenuName))
{
    <span class="muscle chest">
        Chest
    </span>
}

@* 脚トレ *@
@if (legTrainingGroups.Contains(@MenuName))
{
    <span class="muscle leg">
        Leg
    </span>
}

@* 背中トレ *@
@if (backTrainingGroups.Contains(@MenuName))
{
    <span class="muscle back">
        Back
    </span>
}

@code {
    // 脚トレグループ
    private String[] legTrainingGroups = { "Squat", "Leg Press", "Leg Curl", "Leg Extension", "Calf Raise", "Hip Thrust" };
    // 背中トレグループ
    private String[] backTrainingGroups = { "Deadlift", "Lat Pulldown", "Back Extension", "Pull-up", "Row", "T-Bar Row" };
    // 胸トレグループ
    private String[] chestTrainingGroups = { "Bench Press", "Push-up", "Chest Fly", "Incline Press", "Dips", "Machine Press" };

    // パラメータの再定義(筋トレメニュー)
    [Parameter] public string? MenuName { get; set; }
}