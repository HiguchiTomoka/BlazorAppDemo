@rendermode InteractiveServer
@using BlazorAppDemo.Components.Data.DefineDB
@using BlazorAppDemo.Components.Services

@* モーダルコンポーネント *@
@if (isModalOpen)
{
    <div class="modal-overlay">

        <div class="delete-modal">

            <h3>@title</h3>

            <p>
                「@selectedMeal?.MealName」 @message
            </p>

            <div class="modal-buttons">
                <AppButton className="cancel-button" OnClick="CloseModal" buttonValue="キャンセル" />
                <AppButton className=@className OnClick=Click buttonValue=@buttonValue />
            </div>
        </div>

    </div>
}

@code {
    [Parameter]
    public string? title { get; set; }

    [Parameter]
    public string? buttonValue { get; set; }

    [Parameter]
    public string? className { get; set; }

    [Parameter]
    public string? message { get; set; }

    [Parameter]
    public bool isModalOpen { get; set; }

    [Parameter]
    public MealRecordInfo? selectedMeal { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Inject]
    private NutritionManageService NutritionManageService { get; set; } = default!;

    private void CloseModal()
    {
        isModalOpen = false;
    }

    /// <summary>
    /// ボタン押下時処理
    /// </summary>
    /// <returns></returns>
    private async Task Click()
    {
        await OnClick.InvokeAsync();
    }
}